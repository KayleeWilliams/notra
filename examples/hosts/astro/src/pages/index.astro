---
const features = [
  {
    title: "Waters by soil, not by calendar",
    text: "Each watering date follows pot size, light and the season, and gets better every time you check the soil.",
  },
  {
    title: "A light meter in your camera",
    text: "Point your phone at a spot and see whether a plant will be happy there, calibrated for 140 phone models.",
  },
  {
    title: "Health checks from a photo",
    text: "Yellow leaves, brown tips or spots: Fernhill tells you the likely cause and what to change first.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fernhill · Plant care that fits your flat</title>
    <meta name="description" content="Fernhill is the plant-care app that waters by soil, light and season instead of by calendar." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Fernhill Journal" href="/blog/feed.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=Young+Serif&display=swap"
    />
  </head>
  <body>
    <header class="container nav">
      <a href="/" class="brand">
        <img src="/favicon.svg" alt="" width="28" height="28" />
        Fernhill
      </a>
      <nav aria-label="Main">
        <a href="/blog">Blog</a>
        <a href="/changelog">Changelog</a>
      </nav>
    </header>

    <main>
      <section class="container hero">
        <p class="eyebrow">Plant care for real flats</p>
        <h1>Keep every plant alive, even the fiddle-leaf fig.</h1>
        <p class="lead">
          Fernhill plans watering from pot size, light and the season, so your plants get water when they need it, not every
          Sunday.
        </p>
        <div class="actions">
          <a class="button" href="/changelog">See what's new</a>
          <a class="link" href="/blog">Read the journal →</a>
        </div>
      </section>

      <section class="container features" aria-label="Features">
        {
          features.map((feature) => (
            <article class="card">
              <h2>{feature.title}</h2>
              <p>{feature.text}</p>
            </article>
          ))
        }
      </section>
    </main>

    <footer class="container footer">
      <span>© 2026 Fernhill</span>
      <span>Blog and changelog served by <a href="https://usenotra.com">Notra</a></span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #f7f8f2;
    --fg: #17221b;
    --muted: #55645a;
    --border: #dfe5d8;
    --card: #ffffff;
    --accent: #2f7d4a;
    --button: #24653b;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1410;
      --fg: #e9f1ea;
      --muted: #9aaba0;
      --border: #22302a;
      --card: #131c17;
      --accent: #7bcb8f;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: "DM Sans", system-ui, sans-serif;
    color: var(--fg);
    background: var(--bg);
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
  }
  .container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 1.5rem;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--fg);
  }
  .hero {
    padding-top: 6rem;
    padding-bottom: 4rem;
    max-width: 50rem;
    margin-left: max(0px, calc((100% - 72rem) / 2));
  }
  .eyebrow {
    color: var(--accent);
    font-weight: 500;
    margin: 0 0 1rem;
  }
  h1,
  h2 {
    font-family: "Young Serif", Georgia, serif;
    font-weight: 400;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.05;
    margin: 0;
  }
  .lead {
    color: var(--muted);
    font-size: 1.25rem;
    line-height: 1.6;
    max-width: 38rem;
    margin: 1.5rem 0 2rem;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .button {
    background: var(--button);
    color: #fff;
    padding: 0.75rem 1.25rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 500;
  }
  .button:hover {
    background: #1d5230;
  }
  .link {
    color: var(--accent);
    font-weight: 500;
    text-decoration: none;
  }
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
    padding-bottom: 6rem;
  }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1.5rem;
  }
  .card h2 {
    font-size: 1.25rem;
    margin: 0 0 0.5rem;
  }
  .card p {
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }
  .footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    border-top: 1px solid var(--border);
    padding-top: 2rem;
    padding-bottom: 2rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
