{
  "$schema": "https://usenotra.com/schemas/blog.json",
  "name": "Ledgerly",
  "description": "Notes from the team building Ledgerly, the finance workspace for small companies.",
  "logo": "/images/logo.svg",
  "favicon": "/images/favicon.svg",
  "colors": { "primary": "#0F766E", "light": "#2DD4BF", "dark": "#0F766E" },
  "navbar": {
    "links": [
      { "label": "Pricing", "href": "https://usenotra.com/pricing" },
      { "label": "Docs", "href": "https://usenotra.com/docs" }
    ],
    "cta": { "label": "Start free", "href": "https://usenotra.com" }
  },
  "footer": {
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Blog", "href": "/blog" },
          { "label": "Changelog", "href": "/changelog" }
        ]
      },
      {
        "header": "Company",
        "items": [{ "label": "Made with Notra", "href": "https://usenotra.com" }]
      }
    ],
    "socials": { "x": "https://x.com/usenotra", "github": "https://github.com/usenotra/notra" }
  },
  "blog": {
    "title": "Ledgerly Blog",
    "description": "Product news, finance tips for founders and how we build Ledgerly.",
    "layout": "grid",
    "featured": "none",
    "card": { "image": true, "readingTime": true }
  },
  "changelog": {
    "title": "Changelog",
    "description": "New features and fixes, every week.",
    "layout": "timeline"
  },
  "authors": {
    "mara": { "name": "Mara Lindqvist", "title": "Co-founder" },
    "theo": { "name": "Theo Okafor", "title": "Engineer" }
  }
}
