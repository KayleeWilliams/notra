{
  "$schema": "https://usenotra.com/schemas/blog.json",
  "name": "Orbitly",
  "description": "Notes from the team building Orbitly, the satellite imagery API for developers.",
  "logo": "/images/logo.svg",
  "favicon": "/images/favicon.svg",
  "colors": { "primary": "#0891B2", "light": "#22D3EE", "dark": "#06B6D4" },
  "appearance": { "default": "system" },
  "fonts": {
    "heading": { "family": "Space Grotesk", "weight": 600 },
    "body": { "family": "Inter" }
  },
  "background": { "color": { "light": "#F4F7FB", "dark": "#060B1E" } },
  "layout": { "width": 76 },
  "styling": { "codeblocks": { "light": "github-light", "dark": "tokyo-night" } },
  "blog": {
    "title": "Field notes",
    "description": "How we turn raw satellite passes into imagery you can query.",
    "layout": "grid",
    "featured": "none",
    "card": { "image": true, "readingTime": true }
  },
  "changelog": {
    "title": "Changelog",
    "description": "Every change to the Orbitly API, SDKs and console.",
    "layout": "timeline"
  },
  "authors": {
    "ines": { "name": "Ines Carvalho", "title": "Imaging lead" },
    "kofi": { "name": "Kofi Mensah", "title": "API engineer" }
  }
}
