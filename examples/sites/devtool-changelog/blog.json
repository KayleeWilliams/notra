{
  "$schema": "https://usenotra.com/schemas/blog.json",
  "name": "Forgekit",
  "description": "Release notes and engineering posts from the team behind Forgekit, the CLI and SDK for building internal tools.",
  "logo": { "light": "/images/logo.svg", "dark": "/images/logo.svg", "href": "/changelog" },
  "favicon": "/images/favicon.svg",
  "colors": { "primary": "#EA580C", "light": "#FB923C", "dark": "#F97316" },
  "appearance": { "default": "dark", "strict": true },
  "fonts": {
    "heading": { "family": "JetBrains Mono", "weight": 600 },
    "body": { "family": "Inter" }
  },
  "background": { "decoration": "grid", "color": { "dark": "#0A0B0D" } },
  "styling": { "codeblocks": "vitesse-dark" },
  "navbar": {
    "links": [
      { "label": "Docs", "href": "https://usenotra.com/docs", "icon": "book-open" },
      { "label": "Pricing", "href": "https://usenotra.com/pricing" }
    ],
    "primary": { "type": "github", "href": "https://github.com/usenotra/notra" }
  },
  "footer": {
    "links": [
      {
        "header": "Releases",
        "items": [
          { "label": "Changelog", "href": "/changelog" },
          { "label": "Blog", "href": "/blog" }
        ]
      },
      {
        "header": "Resources",
        "items": [
          { "label": "Docs", "href": "https://usenotra.com/docs" },
          { "label": "Pricing", "href": "https://usenotra.com/pricing" },
          { "label": "Made with Notra", "href": "https://usenotra.com" }
        ]
      }
    ],
    "socials": { "github": "https://github.com/usenotra/notra", "x": "https://x.com/usenotra" }
  },
  "changelog": {
    "title": "Changelog",
    "description": "Every Forgekit release: new commands, SDK changes, fixes and the occasional breaking change, with upgrade steps.",
    "layout": "timeline",
    "hero": { "style": "plain", "eyebrow": "$ forge changelog" }
  },
  "blog": {
    "title": "Engineering blog",
    "description": "How we build Forgekit, and how teams use it to ship internal tools.",
    "layout": "list",
    "post": { "width": "narrow" }
  },
  "authors": {
    "ines": { "name": "Ines Varga", "title": "Maintainer, CLI", "github": "https://github.com/usenotra" },
    "kofi": { "name": "Kofi Mensah", "title": "Maintainer, SDK" }
  }
}
