{
  "$schema": "https://usenotra.com/schemas/blog.json",
  "name": "Stonebridge",
  "description": "Notes from the team building Stonebridge, self-hosted backup software for servers, databases and file shares.",
  "logo": { "light": "/images/logo.svg", "dark": "/images/logo.svg", "href": "/" },
  "favicon": "/images/favicon.svg",
  "colors": { "primary": "#4F46E5", "light": "#818CF8", "dark": "#4338CA" },
  "fonts": {
    "heading": { "family": "IBM Plex Serif", "weight": 600 },
    "body": { "family": "IBM Plex Sans", "weight": 400 }
  },
  "background": { "color": { "light": "#F8FAFC", "dark": "#0F172A" } },
  "layout": { "width": 64 },
  "navbar": {
    "links": [
      { "label": "Home", "href": "/" },
      { "label": "Docs", "href": "https://usenotra.com/docs" },
      { "label": "Pricing", "href": "https://usenotra.com/pricing" }
    ],
    "primary": { "type": "github", "href": "https://github.com/usenotra/notra" },
    "cta": { "label": "Download", "href": "https://usenotra.com" }
  },
  "footer": {
    "links": [
      {
        "header": "Stonebridge",
        "items": [
          { "label": "Home", "href": "/" },
          { "label": "Blog", "href": "/blog" },
          { "label": "Changelog", "href": "/changelog" }
        ]
      },
      {
        "header": "Resources",
        "items": [
          { "label": "Docs", "href": "https://usenotra.com/docs" },
          { "label": "Made with Notra", "href": "https://usenotra.com" }
        ]
      }
    ],
    "socials": { "github": "https://github.com/usenotra/notra", "x": "https://x.com/usenotra" }
  },
  "blog": {
    "title": "Stonebridge Blog",
    "description": "Engineering notes, backup guides and product news from the Stonebridge team.",
    "layout": "magazine",
    "hero": { "style": "plain", "eyebrow": "Field notes on backups" },
    "card": { "readingTime": true },
    "post": { "toc": false, "width": "narrow" }
  },
  "changelog": {
    "title": "Changelog",
    "description": "Every Stonebridge release, with upgrade notes.",
    "layout": "timeline"
  },
  "authors": {
    "ines": { "name": "Ines Hartmann", "title": "Founder" },
    "paul": { "name": "Paul Mbeki", "title": "Storage engineer" }
  }
}
