{
  "$schema": "https://usenotra.com/schemas/blog.json",
  "name": "Pixelmint",
  "description": "News from Pixelmint, the open icon and illustration library for product teams.",
  "logo": "/images/logo.svg",
  "favicon": "/images/favicon.svg",
  "colors": { "primary": "#078560", "light": "#5EEAB5", "dark": "#3DDC97" },
  "fonts": {
    "heading": { "family": "Fredoka", "weight": 600 },
    "body": { "family": "Nunito" }
  },
  "background": {
    "decoration": "dots",
    "color": { "light": "#F3FBF7", "dark": "#06140F" }
  },
  "navbar": {
    "links": [
      { "label": "Docs", "href": "https://usenotra.com/docs" },
      { "label": "Pricing", "href": "https://usenotra.com/pricing" }
    ],
    "primary": { "type": "github", "href": "https://github.com/usenotra/notra" },
    "cta": { "label": "Browse icons", "href": "https://usenotra.com" }
  },
  "footer": {
    "links": [
      {
        "header": "Pixelmint",
        "items": [
          { "label": "Blog", "href": "/blog" },
          { "label": "Changelog", "href": "/changelog" }
        ]
      },
      {
        "header": "Built with",
        "items": [
          { "label": "Notra", "href": "https://usenotra.com" },
          { "label": "Notra docs", "href": "https://usenotra.com/docs" }
        ]
      }
    ],
    "socials": { "x": "https://x.com/usenotra", "github": "https://github.com/usenotra/notra" }
  },
  "blog": {
    "title": "The Pixelmint Blog",
    "description": "New icon sets, drawing notes from the studio and how to ship Pixelmint in your app.",
    "layout": "grid",
    "hero": { "style": "image", "image": "/images/hero.png", "eyebrow": "Fresh from the studio" },
    "featured": "none",
    "card": { "image": true, "readingTime": true }
  },
  "changelog": {
    "title": "What's new in Pixelmint",
    "description": "Every icon, illustration and package release.",
    "layout": "timeline"
  },
  "authors": {
    "juno": { "name": "Juno Achterberg", "title": "Icon designer" },
    "ravi": { "name": "Ravi Mendes", "title": "Front-end engineer" }
  }
}
