{
  "$schema": "https://usenotra.com/schemas/blog.json",
  "name": "Nova",
  "description": "Launch notes from the team building Nova, the AI notetaker that writes up your meetings while you talk.",
  "logo": "/images/logo.svg",
  "favicon": "/images/favicon.svg",
  "colors": { "primary": "#E11D8A", "light": "#FF6EC7", "dark": "#E11D8A" },
  "appearance": { "default": "dark", "strict": false },
  "fonts": { "heading": { "family": "Geist", "weight": 600 }, "body": { "family": "Inter" } },
  "background": { "decoration": "gradient" },
  "banner": {
    "content": "**Nova 1.0** is out after 14 months of beta. [Read the launch post](/blog/introducing-nova-1)",
    "type": "info",
    "dismissible": false
  },
  "navbar": {
    "links": [
      { "label": "Pricing", "href": "https://usenotra.com/pricing" },
      { "label": "Docs", "href": "https://usenotra.com/docs" }
    ],
    "primary": { "type": "github", "href": "https://github.com/usenotra/notra" },
    "cta": { "label": "Try Nova free", "href": "https://usenotra.com" }
  },
  "footer": {
    "links": [
      {
        "header": "Launch week",
        "items": [
          { "label": "Day 1: Nova 1.0", "href": "/blog/introducing-nova-1" },
          { "label": "Day 2: Ask Nova", "href": "/blog/ask-nova" },
          { "label": "Day 3: Teams and API", "href": "/blog/nova-for-teams" }
        ]
      },
      {
        "header": "Product",
        "items": [
          { "label": "Changelog", "href": "/changelog" },
          { "label": "Pricing", "href": "https://usenotra.com/pricing" },
          { "label": "Docs", "href": "https://usenotra.com/docs" }
        ]
      },
      {
        "header": "Company",
        "items": [{ "label": "Made with Notra", "href": "https://usenotra.com" }]
      }
    ],
    "socials": { "x": "https://x.com/usenotra", "github": "https://github.com/usenotra/notra" }
  },
  "blog": {
    "title": "Nova launch week",
    "description": "Nova leaves beta with one launch a day. Each post goes up at 9:00 CET, and everything in it is live the moment you read it.",
    "layout": "magazine",
    "featured": ["introducing-nova-1"],
    "card": { "image": true, "readingTime": true }
  },
  "changelog": {
    "title": "Changelog",
    "description": "Every Nova release, from the first beta to 1.0.",
    "layout": "timeline"
  },
  "authors": {
    "ines": { "name": "Ines Kowalczyk", "title": "Co-founder and CEO" },
    "rafael": { "name": "Rafael Duarte", "title": "Co-founder and CTO" },
    "june": { "name": "June Park", "title": "Product designer" }
  },
  "thumbnails": { "appearance": "dark" }
}
