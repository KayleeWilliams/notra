{
  "$schema": "https://usenotra.com/schemas/blog.json",
  "name": "Brightdesk",
  "description": "Notes from the team building Brightdesk, the help desk for small SaaS teams.",
  "logo": { "light": "/images/logo.svg", "dark": "/images/logo.svg", "href": "/" },
  "favicon": "/images/favicon.svg",
  "colors": { "primary": "#C2410C", "light": "#FB923C", "dark": "#C2410C" },
  "fonts": {
    "heading": { "family": "Bricolage Grotesque", "weight": 700 },
    "body": { "family": "Inter" }
  },
  "background": { "color": { "light": "#FFFBF5", "dark": "#17110C" } },
  "navbar": {
    "links": [
      { "label": "Home", "href": "/" },
      { "label": "Pricing", "href": "https://usenotra.com/pricing" },
      { "label": "Docs", "href": "https://usenotra.com/docs" }
    ],
    "cta": { "label": "Try Brightdesk", "href": "https://usenotra.com" }
  },
  "footer": {
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Home", "href": "/" },
          { "label": "Blog", "href": "/blog" },
          { "label": "Changelog", "href": "/changelog" }
        ]
      },
      {
        "header": "Resources",
        "items": [
          { "label": "Docs", "href": "https://usenotra.com/docs" },
          { "label": "Made with Notra", "href": "https://usenotra.com" }
        ]
      }
    ],
    "socials": { "x": "https://x.com/usenotra", "github": "https://github.com/usenotra/notra" }
  },
  "blog": {
    "title": "The Brightdesk Blog",
    "description": "Support playbooks for small SaaS teams, product news and how we build Brightdesk.",
    "layout": "list",
    "card": { "readingTime": true },
    "post": { "width": "narrow" }
  },
  "changelog": {
    "title": "Changelog",
    "description": "What changed in Brightdesk, release by release.",
    "layout": "timeline"
  },
  "authors": {
    "nadia": { "name": "Nadia Brennan", "title": "Head of Support" },
    "kofi": { "name": "Kofi Mensah", "title": "Engineer" }
  }
}
