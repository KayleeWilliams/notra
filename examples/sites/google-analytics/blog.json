    "cta": { "label": "Get a quote", "href": "https://usenotra.com" }
  },
  "footer": {
    "links": [
      {
        "header": "Harborline",
        "items": [
          { "label": "Blog", "href": "/blog" },
          { "label": "Changelog", "href": "/changelog" }
        ]
      },
      {
        "header": "Resources",
        "items": [
          { "label": "Docs", "href": "https://usenotra.com/docs" },
          { "label": "Made with Notra", "href": "https://usenotra.com" }
        ]
      }
    ],
    "socials": { "linkedin": "https://www.linkedin.com/company/usenotra", "github": "https://github.com/usenotra/notra" }
