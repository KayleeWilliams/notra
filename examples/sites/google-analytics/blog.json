  "logo": "/images/logo.svg",
  "favicon": "/images/favicon.svg",
  "colors": { "primary": "#1E3A8A", "light": "#FBBF24", "dark": "#14284B" },
  "fonts": {
    "heading": { "family": "Barlow Condensed", "weight": 600 },
    "body": { "family": "Barlow" }
  },
  "background": { "color": { "light": "#FBFAF6", "dark": "#0B1426" } },
  "banner": {
    "content": "**LCL consolidation** from Ningbo now ships weekly. [See the schedule](/blog/weekly-lcl-from-ningbo)",
    "type": "info",
    "dismissible": true
  },
  "navbar": {
    "links": [
      { "label": "Pricing", "href": "https://usenotra.com/pricing" },
      { "label": "Docs", "href": "https://usenotra.com/docs" }
