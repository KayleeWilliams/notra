{
  "$schema": "https://usenotra.com/schemas/blog.json",
  "name": "Tidepool",
  "description": "Notes from the team building Tidepool, the scheduling tool for swim schools.",
  "logo": { "light": "/images/logo.svg", "dark": "/images/logo.svg", "href": "/" },
  "favicon": "/images/favicon.svg",
  "colors": { "primary": "#0891B2", "light": "#22D3EE", "dark": "#0E7490" },
  "fonts": { "family": "Nunito" },
  "background": {
    "decoration": "gradient",
    "color": { "light": "#F5FDFF", "dark": "#06141A" }
  },
  "navbar": {
    "links": [
      { "label": "Home", "href": "/" },
      { "label": "Docs", "href": "https://usenotra.com/docs" }
    ],
    "cta": { "label": "Book a demo", "href": "https://usenotra.com" }
  },
  "footer": {
    "links": [
      {
        "header": "Tidepool",
        "items": [
          { "label": "Home", "href": "/" },
          { "label": "Blog", "href": "/blog" },
          { "label": "Changelog", "href": "/changelog" }
        ]
      },
      {
        "header": "Built with",
        "items": [
          { "label": "Notra", "href": "https://usenotra.com" },
          { "label": "Pricing", "href": "https://usenotra.com/pricing" },
          { "label": "Source", "href": "https://github.com/usenotra/notra" }
        ]
      }
    ],
    "socials": { "x": "https://x.com/usenotra", "github": "https://github.com/usenotra/notra" }
  },
  "blog": {
    "title": "The Tidepool Blog",
    "description": "Product news and practical advice for people who run swim schools.",
    "layout": "grid",
    "card": { "image": true, "readingTime": true }
  },
  "changelog": {
    "title": "What's new in Tidepool",
    "description": "Every release, with the details your front desk will ask about.",
    "layout": "cards"
  },
  "authors": {
    "ines": {
      "name": "Ines Navarro",
      "title": "Co-founder, ran a swim school for 9 years"
    },
    "kofi": { "name": "Kofi Mensah", "title": "Product engineer" }
  }
}
