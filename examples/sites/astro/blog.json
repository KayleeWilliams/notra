{
  "$schema": "https://usenotra.com/schemas/blog.json",
  "name": "Fernhill",
  "description": "Notes from the team building Fernhill, the plant-care app that waters by soil, light and season instead of by calendar.",
  "logo": { "light": "/images/logo.svg", "dark": "/images/logo.svg", "href": "/" },
  "favicon": "/images/favicon.svg",
  "colors": { "primary": "#2F7D4A", "light": "#7BCB8F", "dark": "#24653B" },
  "fonts": {
    "heading": { "family": "Young Serif", "weight": 400 },
    "body": { "family": "DM Sans" }
  },
  "background": { "color": { "light": "#F7F8F2", "dark": "#0D1410" } },
  "navbar": {
    "links": [
      { "label": "App", "href": "/" },
      { "label": "Pricing", "href": "https://usenotra.com/pricing" },
      { "label": "Docs", "href": "https://usenotra.com/docs" }
    ],
    "cta": { "label": "Get Fernhill", "href": "/" }
  },
  "footer": {
    "links": [
      {
        "header": "Fernhill",
        "items": [
          { "label": "Home", "href": "/" },
          { "label": "Blog", "href": "/blog" },
          { "label": "Changelog", "href": "/changelog" }
        ]
      },
      {
        "header": "Resources",
        "items": [
          { "label": "Docs", "href": "https://usenotra.com/docs" },
          { "label": "Made with Notra", "href": "https://usenotra.com" }
        ]
      }
    ],
    "socials": { "instagram": "https://www.instagram.com/usenotra", "github": "https://github.com/usenotra/notra" }
  },
  "blog": {
    "title": "The Fernhill Journal",
    "description": "Plant care that works in real flats, and how we build the app that helps with it.",
    "layout": "grid",
    "hero": { "style": "image", "image": "/images/hero.png", "eyebrow": "From the greenhouse" },
    "featured": "none",
    "card": { "image": true, "readingTime": true }
  },
  "changelog": {
    "title": "Changelog",
    "description": "What changed in the Fernhill app for iOS and Android.",
    "layout": "timeline"
  },
  "authors": {
    "ana": { "name": "Ana Petrović", "title": "Co-founder, horticulturist" },
    "joel": { "name": "Joel Brandt", "title": "Mobile engineer" }
  }
}
