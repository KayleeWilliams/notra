{
  "$schema": "https://usenotra.com/schemas/blog.json",
  "name": "Quillstack",
  "description": "Notes from the team building Quillstack, the headless CMS for agencies that run many client sites.",
  "logo": { "light": "/images/logo.svg", "dark": "/images/logo.svg", "href": "/" },
  "favicon": "/images/favicon.svg",
  "colors": { "primary": "#E5241B", "light": "#E5241B", "dark": "#0A0A0A" },
  "appearance": { "default": "light", "strict": true },
  "fonts": {
    "heading": { "family": "Archivo", "weight": 800 },
    "body": { "family": "Inter" }
  },
  "background": { "color": { "light": "#FFFFFF" } },
  "styling": { "codeblocks": "dark" },
  "layout": { "width": 64 },
  "navbar": {
    "links": [
      { "label": "Product", "href": "/" },
      { "label": "Pricing", "href": "https://usenotra.com/pricing" },
      { "label": "Docs", "href": "https://usenotra.com/docs" }
    ],
    "cta": { "label": "Start a workspace", "href": "https://usenotra.com" }
  },
  "footer": {
    "links": [
      {
        "header": "Quillstack",
        "items": [
          { "label": "Home", "href": "/" },
          { "label": "Blog", "href": "/blog" },
          { "label": "Changelog", "href": "/changelog" }
        ]
      },
      {
        "header": "Resources",
        "items": [
          { "label": "Pricing", "href": "https://usenotra.com/pricing" },
          { "label": "Docs", "href": "https://usenotra.com/docs" },
          { "label": "Made with Notra", "href": "https://usenotra.com" }
        ]
      }
    ],
    "socials": { "x": "https://x.com/usenotra", "github": "https://github.com/usenotra/notra" }
  },
  "blog": {
    "title": "Quillstack Blog",
    "description": "How agencies run content for many clients, and what we ship to make that easier.",
    "layout": "list",
    "card": { "readingTime": true },
    "post": { "width": "narrow" }
  },
  "changelog": {
    "title": "Changelog",
    "description": "Every Quillstack release, newest first.",
    "layout": "compact"
  },
  "authors": {
    "ines": { "name": "Ines Varga", "title": "Co-founder, product" },
    "kofi": { "name": "Kofi Mensah", "title": "Platform engineer" }
  }
}
