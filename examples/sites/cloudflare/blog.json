{
  "$schema": "https://usenotra.com/schemas/blog.json",
  "name": "Relaywave",
  "description": "Engineering notes and release news from Relaywave, the webhook delivery infrastructure for API teams.",
  "logo": { "light": "/images/logo.svg", "dark": "/images/logo.svg", "href": "/" },
  "favicon": "/images/favicon.svg",
  "colors": { "primary": "#C2410C", "light": "#F6821F", "dark": "#C2410C" },
  "appearance": { "default": "dark", "strict": true },
  "fonts": {
    "heading": { "family": "Space Grotesk", "weight": 600 },
    "body": { "family": "Inter" }
  },
  "background": {
    "decoration": "grid",
    "color": { "dark": "#0C0A09" }
  },
  "styling": { "codeblocks": "dark" },
  "navbar": {
    "links": [
      { "label": "Home", "href": "/" },
      { "label": "Docs", "href": "https://usenotra.com/docs", "icon": "book-open" }
    ],
    "primary": { "type": "github", "href": "https://github.com/usenotra/notra" },
    "cta": { "label": "Start sending", "href": "https://usenotra.com" }
  },
  "footer": {
    "links": [
      {
        "header": "Relaywave",
        "items": [
          { "label": "Home", "href": "/" },
          { "label": "Blog", "href": "/blog" },
          { "label": "Changelog", "href": "/changelog" }
        ]
      },
      {
        "header": "Resources",
        "items": [
          { "label": "Pricing", "href": "https://usenotra.com/pricing" },
          { "label": "Made with Notra", "href": "https://usenotra.com" }
        ]
      }
    ],
    "socials": { "github": "https://github.com/usenotra/notra", "x": "https://x.com/usenotra" }
  },
  "blog": {
    "title": "Relaywave Engineering",
    "description": "How we deliver webhooks: retries, signatures, queues and the incidents that taught us something.",
    "layout": "grid",
    "card": { "image": true, "readingTime": true }
  },
  "changelog": {
    "title": "Changelog",
    "description": "Every change to the Relaywave API, dashboard and SDKs.",
    "layout": "cards"
  },
  "authors": {
    "ines": { "name": "Ines Carvalho", "title": "Founding engineer", "github": "https://github.com/usenotra" },
    "kenji": { "name": "Kenji Mori", "title": "Platform lead" }
  },
  "markdown": {
    "instructions": "Relaywave delivers webhooks for other APIs. Code samples use the public REST API at api.relaywave.dev and the @relaywave/node SDK."
  }
}
