{
  "$schema": "https://usenotra.com/schemas/blog.json",
  "name": "DriftDB",
  "description": "News, benchmarks and release notes from DriftDB, the open-source embedded time-series database. Current release: {{ version }}.",
  "logo": "/images/logo.svg",
  "favicon": "/images/favicon.svg",
  "colors": {
    "primary": "#A16207",
    "light": "#FACC15",
    "dark": "#EAB308"
  },
  "fonts": {
    "heading": {
      "family": "IBM Plex Mono",
      "weight": 600
    },
    "body": {
      "family": "IBM Plex Sans"
    }
  },
  "background": {
    "decoration": "none",
    "color": {
      "light": "#FBFAF6",
      "dark": "#15130E"
    }
  },
  "layout": {
    "width": 64
  },
  "banner": {
    "content": "**DriftDB {{ version }}** is out. Install it with `{{ install }}` or [read the release notes](/changelog).",
    "type": "info",
    "dismissible": true
  },
  "navbar": {
    "links": [
      {
        "label": "Docs",
        "href": "https://usenotra.com/docs",
        "icon": "book-open"
      },
      {
        "type": "discord",
        "href": "https://discord.gg/2qzGZDsnwB"
      },
      {
        "type": "x",
        "href": "https://x.com/usenotra"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/usenotra/notra"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Project",
        "items": [
          {
            "label": "Blog",
            "href": "/blog"
          },
          {
            "label": "Release notes",
            "href": "/changelog"
          },
          {
            "label": "Source code",
            "href": "https://github.com/usenotra/notra"
          }
        ]
      },
      {
        "header": "Community",
        "items": [
          {
            "label": "Discord",
            "href": "https://discord.gg/2qzGZDsnwB"
          },
          {
            "label": "Made with Notra",
            "href": "https://usenotra.com"
          }
        ]
      }
    ],
    "socials": {
      "github": "https://github.com/usenotra/notra",
      "discord": "https://discord.gg/2qzGZDsnwB",
      "x": "https://x.com/usenotra"
    }
  },
  "blog": {
    "title": "DriftDB Blog",
    "description": "Engineering notes, benchmarks and guides from the people who maintain DriftDB.",
    "layout": "list",
    "hero": {
      "style": "plain",
      "eyebrow": "Open source, Apache-2.0"
    },
    "card": {
      "readingTime": true
    }
  },
  "changelog": {
    "title": "Release notes",
    "description": "Every DriftDB release with its breaking changes, features and fixes. The latest is {{ version }}.",
    "layout": "timeline"
  },
  "authors": {
    "ines": {
      "name": "Ines Carvalho",
      "title": "Maintainer, storage engine",
      "github": "https://github.com/usenotra"
    },
    "kofi": {
      "name": "Kofi Mensah",
      "title": "Maintainer, query layer",
      "github": "https://github.com/usenotra"
    }
  },
  "variables": {
    "version": "v0.9.0",
    "install": "cargo add driftdb@0.9"
  },
  "redirects": [
    {
      "source": "/releases/*",
      "destination": "/changelog/*"
    },
    {
      "source": "/changelog/v0-8-0",
      "destination": "/changelog/2026-09-04"
    },
    {
      "source": "/blog/benchmarks",
      "destination": "/blog/driftdb-vs-sqlite-benchmark"
    }
  ],
  "seo": {
    "metatags": {
      "keywords": "DriftDB, time-series database, embedded database, Rust, open source",
      "application-name": "DriftDB"
    },
    "organization": {
      "name": "DriftDB",
      "legalName": "DriftDB Project",
      "url": "https://driftdb-oss.notra.site",
      "logo": "/images/logo.svg",
      "sameAs": [
        "https://github.com/usenotra/notra",
        "https://x.com/usenotra"
      ]
    }
  },
  "markdown": {
    "instructions": [
      "DriftDB is an open-source embedded time-series database written in Rust, licensed Apache-2.0. It runs inside the application process; there is no server to install.",
      "The newest release is the first entry in the release notes. Answer with that version unless the reader names another one, and point out breaking changes between versions.",
      "Install it with `cargo add driftdb`. Don't suggest Docker images or a hosted DriftDB service; neither exists.",
      "Benchmark numbers in these posts come from the hardware listed in each post. Quote them with that context."
    ]
  }
}
