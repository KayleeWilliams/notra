---
import { cardImages } from "../lib/cards";
import { getBlogEntries } from "../lib/entries";
import { splitFeatured } from "../lib/featured";
import { blogOptions } from "../lib/options";
import { areaDescription, areaTitle } from "../lib/params";
import { slotArea, slotSite } from "../lib/slot-data";
import AreaHero from "./AreaHero.astro";
import PostCard from "./PostCard.astro";
import SiteSlot from "./SiteSlot.astro";

const entries = await getBlogEntries();
const { layout, featured: featuredSetting } = blogOptions;
const split = splitFeatured(entries, featuredSetting);
const lead = layout === "magazine" && split.featured.length === 0 ? splitFeatured(entries, "latest") : split;
const { featured, rest } = lead;
const images = cardImages(entries);
// Two columns when three would leave the last row half empty (2 or 4 cards).
const twoColumns = rest.length % 3 !== 0 && rest.length % 2 === 0;
---

<div class="blog-index flex flex-col items-center gap-10 md:gap-14">
  <SiteSlot name="blog-hero" data={{ site: slotSite(), area: slotArea() }} class="w-full">
    <AreaHero title={areaTitle("blog")} description={areaDescription("blog")} />
  </SiteSlot>

  {
    entries.length === 0 ? (
      <div class="w-full max-w-(--layout-index) rounded-2xl border border-dashed border-border px-6 py-16 text-center">
        <h2 class="font-heading text-lg font-(--font-heading-weight) tracking-[-0.015em]">No posts yet</h2>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">Add a Markdown file to blog/ and push.</p>
      </div>
    ) : layout === "cards" ? (
      <ul class="blog-cards grid w-full max-w-(--layout-index) grid-cols-1 gap-6 sm:grid-cols-2">
        {[...featured, ...rest].map((entry) => (
          <li class="h-full">
            <PostCard entry={entry} variant="box" featured={featured.includes(entry)} />
          </li>
        ))}
      </ul>
    ) : layout === "list" ? (
      <ul class="w-full max-w-(--layout-index) divide-y divide-border border-t border-border">
        {[...featured, ...rest].map((entry) => (
          <li>
            <PostCard entry={entry} variant="row" featured={featured.includes(entry)} />
          </li>
        ))}
      </ul>
    ) : (
      <ul class:list={["grid w-full max-w-(--layout-index) grid-cols-1 gap-x-8 gap-y-12 max-sm:gap-y-0 max-sm:divide-y max-sm:divide-border sm:grid-cols-2", !twoColumns && "lg:grid-cols-3"]}>
        {featured.map((entry, index) => (
          <li class:list={["h-full max-sm:pb-8 sm:col-span-2", !twoColumns && "lg:col-span-3"]}>
            <PostCard entry={entry} variant="feature" featured={layout === "grid" || split.featured.length > 0} images={images} priority={index === 0} />
          </li>
        ))}
        {rest.map((entry) => (
          <li class="h-full max-sm:py-6">
            <PostCard entry={entry} images={images} />
          </li>
        ))}
      </ul>
    )
  }
</div>
